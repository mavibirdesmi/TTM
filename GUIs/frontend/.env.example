# Frontend Environment Variables
# Copy this to .env.local and customize for your setup
#
# Usage:
#   cp .env.example .env.local
#   Edit .env.local with your settings
#   npm run dev

# ============================================
# Backend API URL Configuration
# ============================================

# Local Development (Default)
# Backend running on the same machine
VITE_API_URL=http://localhost:8000

# Remote Server - Local Network
# Backend on another machine in your network
# Find server IP with: hostname -I (on the server)
# VITE_API_URL=http://192.168.1.100:8000
# VITE_API_URL=http://10.0.0.50:8000

# Remote Server - Public Domain
# Backend accessible via domain name or public IP
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_URL=http://your-public-ip:8000

# Cloud Server Examples
# VITE_API_URL=http://ec2-xx-xx-xx-xx.compute.amazonaws.com:8000
# VITE_API_URL=http://your-gcp-instance:8000

# ============================================
# Notes
# ============================================
# 
# - Don't include /api at the end (it's added automatically)
# - Use http:// for local/development, https:// for production
# - Make sure backend is accessible from your frontend machine
# - You can also change this at runtime using the UI (click "Backend" button)
# - Changes require npm run dev restart to take effect

